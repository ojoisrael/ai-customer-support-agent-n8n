    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Search the ACME Electronics knowledge base for accurate information about company policies, products, shipping, refunds, returns, warranties, and customer support. Use this tool whenever you need information about ACME Electronics that may be contained in the company's knowledge base. Do not invent information when the knowledge base does not contain the answer.",
        "tableName": {
